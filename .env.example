# ─────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://dev-aditya.com

# ─────────────────────────────────────────────────────────────
# Resend (transactional email — used by /api/contact AND digital-product fulfilment)
# Create a key at https://resend.com/api-keys
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=

# Verified "from" address for /contact enquiry emails.
# Must be a sender you have verified inside Resend.
CONTACT_FROM_EMAIL=Website Enquiries <enquiries@send.dev-aditya.com>

# Recipient address for /contact enquiries (Aditya's inbox).
CONTACT_TO_EMAIL=work@dev-aditya.com

# Optional: comma-separated list of extra allowed origins for the
# contact API's same-origin check. Defaults to the request origin and
# NEXT_PUBLIC_SITE_URL.
# AUDIT_ALLOWED_ORIGINS=https://dev-aditya.com,https://www.dev-aditya.com

# ─────────────────────────────────────────────────────────────
# Digital Products Store — transactional / support email
# ─────────────────────────────────────────────────────────────
# "From" address for the purchase-confirmation / download-link email.
# Must be a sender verified inside Resend. Defaults to CONTACT_FROM_EMAIL if unset.
DIGITAL_PRODUCTS_FROM_EMAIL=Digital Products <no-reply@send.dev-aditya.com>

# Support inbox linked from checkout, success and policy pages.
DIGITAL_PRODUCTS_SUPPORT_EMAIL=work@dev-aditya.com

# ─────────────────────────────────────────────────────────────
# Razorpay (Standard Checkout + Orders API + webhooks)
# https://dashboard.razorpay.com/applications
# Use TEST keys first; switch to LIVE keys only after QA passes.
# RAZORPAY_KEY_ID is safe to expose to the browser (Checkout needs it);
# RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET MUST stay server-side.
# ─────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
# Store pricing / currency
# ─────────────────────────────────────────────────────────────
# Currency used for Razorpay order creation. Must match the merchant account.
# Displayed currency always matches the Razorpay order currency — no live FX.
STORE_CURRENCY=INR

# ─────────────────────────────────────────────────────────────
# Secure download entitlement
# ─────────────────────────────────────────────────────────────
# Server-only HMAC secret used to sign/verify download tokens (7-day TTL).
# Generate with: openssl rand -hex 32
DOWNLOAD_TOKEN_SECRET=

# ─────────────────────────────────────────────────────────────
# Database (Prisma — SQLite for local dev; use a durable Postgres in production)
# ─────────────────────────────────────────────────────────────
# Local SQLite (dev only):
DATABASE_URL="file:./dev.db"
# Production (Neon / Vercel Postgres / other):
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ─────────────────────────────────────────────────────────────
# Private product file storage
# ─────────────────────────────────────────────────────────────
# Paid product ZIPs MUST NOT live under public/.
# Local filesystem fallback (dev only). Directory must exist and be readable
# by the server, NOT served statically. Files follow the convention:
#   {PRODUCT_FILES_DIR}/{productId}.zip
PRODUCT_FILES_DIR=

# Optional S3-compatible / R2 storage (production). If all four are set, the
# download route can stream from object storage instead of the local FS.
# PRODUCT_STORAGE_PROVIDER=s3
# PRODUCT_STORAGE_BUCKET=
# PRODUCT_STORAGE_ENDPOINT=
# PRODUCT_STORAGE_ACCESS_KEY_ID=
# PRODUCT_STORAGE_SECRET_ACCESS_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://dev-aditya.com

# Resend (transactional email — used by the /api/contact route)
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Verified "from" address for /contact enquiry emails.
# Must be a sender you have verified inside Resend.
CONTACT_FROM_EMAIL=Website Enquiries <enquiries@send.dev-aditya.com>

# Recipient address for /contact enquiries (Aditya's inbox).
CONTACT_TO_EMAIL=work@dev-aditya.com

# Optional: comma-separated list of extra allowed origins for the
# contact API's same-origin check. Defaults to the request origin and
# NEXT_PUBLIC_SITE_URL.
# AUDIT_ALLOWED_ORIGINS=https://dev-aditya.com,https://www.dev-aditya.com
